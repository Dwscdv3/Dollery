{
  "_说明": "复制此文件为 config.json 后填写。config.json 已被 .gitignore 忽略，不会进入仓库。",

  "proxy": "http://127.0.0.1:7897",
  "intervalMs": 2000,

  "cookie": "",
  "cookieFile": ".secrets/cookies.txt",
  "userId": "",

  "includeNovels": true,

  "pageSize": {
    "illust": 48,
    "novel": 24
  },

  "maxPagesPerRun": 0,

  "output": {
    "illustPublic": "data/bookmarks-illust.txt",
    "illustPrivate": "data/bookmarks-illust-private.txt",
    "novelPublic": "data/bookmarks-novel.txt",
    "novelPrivate": "data/bookmarks-novel-private.txt"
  },

  "download": {
    "dir": "images",
    "avifQuality": 50,
    "imageIntervalMs": 1000,
    "keepOriginal": false
  }
}
