{
  "_说明": "复制此文件为 config.json 后填写。config.json 已被 .gitignore 忽略，不会进入仓库。",

  "proxy": "http://127.0.0.1:7897",
  "intervalMs": 2000,

  "cookie": "",
  "cookieFile": ".secrets/cookies.txt",
  "userId": "",

  "includeNovels": true,

  "pageSize": {
    "illust": 100,
    "novel": 100
  },

  "maxPagesPerRun": 0,

  "output": {
    "illustPublic": "data/bookmarks-illust.json",
    "illustPrivate": "data/bookmarks-illust-private.json",
    "novelPublic": "data/bookmarks-novel.json",
    "novelPrivate": "data/bookmarks-novel-private.json"
  },

  "download": {
    "dir": "images",
    "avifQuality": 50,
    "imageIntervalMs": 1000,
    "keepOriginal": false
  },

  "_pacer说明": "概率触发的随机长休息：每个后台请求有 pauseChance 的概率休息一次；休息时长期望 = 距上次休息的请求数 × perRequestMs，夹在 minPauseMs~maxPauseMs 之间，再按 Gamma 分布抽样（shape=1 即指数分布，越大越集中）；连续请求数每 decayMs 减 1，最少到 0（空闲时计数会回落）。enabled 设 false 可整体关闭。",
  "pacer": {
    "enabled": true,
    "pauseChance": 0.01,
    "perRequestMs": 5000,
    "decayMs": 5000,
    "minPauseMs": 60000,
    "maxPauseMs": 5400000,
    "shape": 2
  },

  "bookmarkTags": {
    "enabled": true,
    "cacheDir": ".cache"
  }
}
