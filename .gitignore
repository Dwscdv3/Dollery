# 认证信息绝不入库
config.json
.secrets/
cookies.txt
*.cookie

# 个人收藏数据：只留在本地，绝不入库
data/

# 收藏标签映射缓存（可重建，不入库）
.cache/
viewer/.thumbs/

# 查看器的临时产物（调试截图、临时浏览器 profile）
viewer/.edgeprofile*/
viewer/_shot.png
viewer/_dom.html
viewer/_cdp.mjs
viewer/_guard.mjs
viewer/_guard*.png

# 依赖与运行产物
node_modules/
.last-sync.json
*.log

# 预留：图片下载目录（功能尚未实现，先占位避免误提交）
images/
